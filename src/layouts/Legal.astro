---
import { Check } from "lucide-react";
import type { LegalBlock, LegalDocument, LegalList, RichText } from "@/data/legal";
import { site } from "@/data/site";
import Base from "@/layouts/Base.astro";
import { formatDate } from "@/lib/formatting/number";

type Props = LegalDocument;

const { link, description, updatedAt, sections } = Astro.props;

const isList = (block: LegalBlock): block is LegalList => typeof block !== "string" && "items" in block;
const toSegments = (text: RichText) => typeof text === "string" ? [text] : text;
---

<Base title={`${link.label} | ${site.name}`} description={description}>
    <article class="container-page legal">
        <header class="legal__header stagger">
            <h1>{link.label}</h1>
            <p class="legal__date">Dernière mise à jour : <time datetime={updatedAt}>{formatDate(updatedAt)}</time></p>
        </header>
        {sections.map(({ title, blocks }) => (
                <section class="legal__section reveal">
                    <h2>{title}</h2>
                    {blocks.map((block) => isList(block) ? (
                            <ul class="legal__list">
                                {block.items.map((item) => (
                                        <li><Check size={16} strokeWidth={3} aria-hidden="true"/>{item}</li>
                                ))}
                            </ul>
                    ) : (
                            <p>
                                {toSegments(block).map((segment) => typeof segment === "string" ? segment : (
                                        <a class="legal__link" href={segment.href}>{segment.label}</a>
                                ))}
                            </p>
                    ))}
                </section>
        ))}
    </article>
</Base>

<style>
    .legal {
        display: grid;
        gap: 2.5rem;
        max-width: 55rem !important;
        padding-top: 3rem;
    }

    .legal__header {
        display: grid;
        gap: 0.75rem;
    }

    .legal__header h1 {
        font-size: var(--text-h2);
    }

    .legal__date {
        color: var(--muted-foreground);
    }

    .legal__section {
        display: grid;
        gap: 1rem;
    }

    .legal__section h2 {
        font-size: 1.25rem;
    }

    .legal__list {
        display: grid;
        gap: 1rem;
    }

    .legal__list li {
        display: flex;
        gap: 0.5rem;
    }

    .legal__list :global(svg) {
        flex-shrink: 0;
        margin-top: 0.375rem;
        color: var(--foreground);
    }

    .legal__link {
        font-weight: 600;
        color: var(--foreground);
        text-decoration: underline;
        text-underline-offset: 0.25rem;
        transition: color 0.2s ease;
    }

    .legal__link:hover {
        color: var(--brand);
    }
</style>
