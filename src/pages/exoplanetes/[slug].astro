---
import { ArrowUpRight, Info, TriangleAlert } from "lucide-react";
import SolarComparison from "@/components/charts/SolarComparison.astro";
import { AddToComparison } from "@/components/exoplanets/add-to-comparison";
import { MethodBadge } from "@/components/exoplanets/method-badge";
import PlanetCard from "@/components/exoplanets/PlanetCard.astro";
import PlanetFacts from "@/components/exoplanets/PlanetFacts.astro";
import { Alert, AlertDescription, AlertTitle } from "@/components/ui/alert";
import { Badge } from "@/components/ui/badge";
import {
    Breadcrumb,
    BreadcrumbItem,
    BreadcrumbLink,
    BreadcrumbList,
    BreadcrumbPage,
    BreadcrumbSeparator
} from "@/components/ui/breadcrumb";
import { catalog } from "@/data/catalog";
import { getPlanetPath, pages, site } from "@/data/site";
import type { ValueOrigin } from "@/domain/exoplanets/model";
import { findSimilarPlanets } from "@/domain/exoplanets/related";
import { isSlug } from "@/domain/exoplanets/text";
import { cachePolicies } from "@/lib/cache/policies";
import { originDescriptions, originLabels } from "@/lib/formatting/measurement";
import { formatDate } from "@/lib/formatting/number";
import { describePlanet } from "@/lib/formatting/summary";
import { getCatalogueUrl } from "@/lib/url";
import { archiveDocumentationUrl, getArchiveOverviewUrl } from "@/services/exoplanet-archive/links";
import Base from "@/layouts/Base.astro";

export const prerender = false;

const slug = Astro.params.slug ?? "";
const planet = isSlug(slug) ? catalog.findBySlug(slug) : null;
if (!planet) return new Response(null, { status: 404 });

Astro.response.headers.set("Cache-Control", cachePolicies.planet);

const summary = describePlanet(planet);
const siblings = catalog.findSystem(planet).filter(({ slug: current }) => current !== planet.slug);
const similar = findSimilarPlanets(catalog.entries, planet, 3);
const origins = [...new Set(Object.values(planet.provenance))].filter((origin): origin is ValueOrigin => origin !== undefined);
const title = `${planet.name} | ${site.name}`;
const description = summary.slice(0, 2).join(" ");
---

<Base title={title} description={description}>
    <article class="container-page planet">
        <Breadcrumb>
            <BreadcrumbList>
                <BreadcrumbItem><BreadcrumbLink href={pages.home}>Accueil</BreadcrumbLink></BreadcrumbItem>
                <BreadcrumbSeparator/>
                <BreadcrumbItem><BreadcrumbLink href={pages.catalogue}>Catalogue</BreadcrumbLink></BreadcrumbItem>
                <BreadcrumbSeparator/>
                <BreadcrumbItem><BreadcrumbPage>{planet.name}</BreadcrumbPage></BreadcrumbItem>
            </BreadcrumbList>
        </Breadcrumb>

        <header class="planet__header stagger">
            <h1 class="planet__title">{planet.name}</h1>
            <p class="planet__host">
                {planet.hostStarName ? (
                        <>Étoile hôte : <a href={getCatalogueUrl({ host: planet.hostStarName })}>{planet.hostStarName}</a></>
                ) : "Étoile hôte non renseignée"}
            </p>
            <div class="planet__badges">
                <MethodBadge method={planet.discoveryMethod}/>
                <Badge variant="outline">{planet.discoveryYear ? `Découverte en ${planet.discoveryYear}` : "Année non renseignée"}</Badge>
                {planet.controversial && <Badge variant="destructive">Existence contestée</Badge>}
            </div>
            <p class="planet__summary">{summary.join(" ")}</p>
            <AddToComparison client:load slug={planet.slug} name={planet.name}/>
        </header>

        {planet.controversial && (
                <Alert variant="destructive">
                    <TriangleAlert aria-hidden="true"/>
                    <AlertTitle>Planète dont l'existence est contestée</AlertTitle>
                    <AlertDescription>
                        La NASA Exoplanet Archive signale que la confirmation de cette planète a été remise en question dans
                        la littérature scientifique.
                    </AlertDescription>
                </Alert>
        )}

        <div class="planet__layout">
            <section class="panel" aria-labelledby="caracteristiques-titre">
                <h2 id="caracteristiques-titre" class="panel__title">Caractéristiques</h2>
                <PlanetFacts planet={planet}/>
                {origins.length > 0 && (
                        <dl class="legend">
                            {origins.map((origin) => (
                                    <div>
                                        <dt>{originLabels[origin]}</dt>
                                        <dd>{originDescriptions[origin]}</dd>
                                    </div>
                            ))}
                        </dl>
                )}
            </section>

            <aside class="planet__aside">
                <section class="panel" aria-labelledby="comparaison-titre">
                    <h2 id="comparaison-titre" class="panel__title">Face au Système solaire</h2>
                    <SolarComparison planet={planet}/>
                </section>
                <Alert>
                    <Info aria-hidden="true"/>
                    <AlertTitle>Limites des données</AlertTitle>
                    <AlertDescription className="grid gap-2">
                        <p>
                            Ces valeurs combinent plusieurs publications : elles ne forment pas toujours un ensemble cohérent
                            et chacune comporte une incertitude, non affichée ici.
                        </p>
                        <p>
                            La température d'équilibre suppose une planète sans atmosphère : elle ne correspond pas à la
                            température de surface.
                        </p>
                    </AlertDescription>
                </Alert>
            </aside>
        </div>

        {siblings.length > 0 && (
                <section aria-labelledby="systeme-titre">
                    <h2 id="systeme-titre" class="planet__section-title">Dans le même système</h2>
                    <ul class="siblings">
                        {siblings.map((sibling) => (
                                <li><a class="sibling" href={getPlanetPath(sibling.slug)}>{sibling.name}</a></li>
                        ))}
                    </ul>
                </section>
        )}

        {similar.length > 0 && (
                <section aria-labelledby="similaires-titre">
                    <h2 id="similaires-titre" class="planet__section-title">Mondes comparables dans d'autres systèmes</h2>
                    <p class="planet__section-text">Planètes de taille et de période orbitale proches, autour d'autres étoiles.</p>
                    <ul class="similar">
                        {similar.map((candidate) => <li><PlanetCard planet={candidate}/></li>)}
                    </ul>
                </section>
        )}

        <footer class="source">
            <p>
                Source : {catalog.snapshot.source.name}, table {catalog.snapshot.source.table}, snapshot du
                {" "}{formatDate(catalog.snapshot.retrievedAt)}.
            </p>
            <ul class="source__links">
                <li>
                    <a href={getArchiveOverviewUrl(planet.name)} target="_blank" rel="noopener noreferrer">
                        Fiche de {planet.name} sur la NASA Exoplanet Archive
                        <ArrowUpRight size={16} aria-hidden="true"/>
                    </a>
                </li>
                <li>
                    <a href={archiveDocumentationUrl} target="_blank" rel="noopener noreferrer">
                        Documentation de la table des paramètres composites
                        <ArrowUpRight size={16} aria-hidden="true"/>
                    </a>
                </li>
            </ul>
        </footer>
    </article>
</Base>

<style>
    .planet {
        display: grid;
        gap: 2.5rem;
        padding-top: 2rem;
    }

    .planet__header {
        display: grid;
        justify-items: start;
        gap: 1rem;
        max-width: 48rem;
    }

    .planet__title {
        font-size: var(--text-h1);
    }

    .planet__host a {
        font-weight: 600;
        color: var(--foreground);
        text-decoration: underline;
        text-underline-offset: 0.25rem;
    }

    .planet__badges {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .planet__summary {
        font-size: 1.0625rem;
    }

    .planet__layout {
        display: grid;
        gap: 1.5rem;
    }

    @media (min-width: 80rem) {
        .planet__layout {
            grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
            align-items: start;
        }
    }

    .planet__aside {
        display: grid;
        gap: 1.5rem;
    }

    .panel {
        display: grid;
        gap: 1.5rem;
        padding: 1.5rem;
        background-color: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
    }

    @media (min-width: 48rem) {
        .panel {
            padding: 2rem;
        }
    }

    .panel__title {
        font-size: 1.375rem;
    }

    .legend {
        display: grid;
        gap: 0.5rem;
        padding-top: 1.25rem;
        font-size: 0.875rem;
        border-top: 1px solid var(--border);
    }

    .legend dt {
        display: inline;
        font-weight: 600;
        color: var(--foreground);
    }

    .legend dt::after {
        content: " : ";
    }

    .legend dd {
        display: inline;
    }

    .planet__section-title {
        margin-bottom: 0.75rem;
        font-size: 1.5rem;
    }

    .planet__section-text {
        margin-bottom: 1.25rem;
    }

    .siblings {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .sibling {
        display: inline-flex;
        padding: 0.375rem 0.875rem;
        font-weight: 600;
        color: var(--foreground);
        border: 1px solid var(--border);
        border-radius: 999px;
        transition: background-color 0.2s ease;
    }

    .sibling:hover {
        background-color: var(--accent);
    }

    .similar {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
        gap: 1.25rem;
    }

    .source {
        display: grid;
        gap: 0.5rem;
        padding-top: 1.5rem;
        font-size: 0.875rem;
        color: var(--muted-foreground);
        border-top: 1px solid var(--border);
    }

    .source__links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
    }

    .source__links a {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        font-weight: 600;
        color: var(--foreground);
        text-underline-offset: 0.25rem;
    }

    .source__links a:hover {
        text-decoration: underline;
    }
</style>
